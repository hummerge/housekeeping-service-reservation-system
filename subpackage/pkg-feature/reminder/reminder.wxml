<view class="page">
  <view class="nav-bar">
    <text class="nav-title">{{navTitle}}</text>
  </view>

  <scroll-view scroll-y class="content">
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-city">{{weather.city}}</view>
          <view class="hero-date">{{weather.dateText}}</view>
        </view>
        <view class="hero-weather-box">
          <view class="hero-weather">{{weather.weatherText}}</view>
          <view class="hero-temp">{{weather.temp}}</view>
          <view class="hero-temp-range" wx:if="{{weather.tempRange}}">{{weather.tempRange}}</view>
        </view>
      </view>
      <view class="hero-meta" wx:if="{{weather.humidity || weather.windDir}}">
        <text wx:if="{{weather.humidity}}" class="hero-meta-item">{{weather.humidity}}</text>
        <text wx:if="{{weather.windDir}}" class="hero-meta-item">{{weather.windDir}}</text>
      </view>
      <view class="hero-tip">{{weather.tip}}</view>
    </view>

    <view class="summary-row">
      <view class="summary-card">
        <view class="summary-num">{{summary.total}}</view>
        <view class="summary-label">{{summaryL1}}</view>
      </view>
      <view class="summary-card warning">
        <view class="summary-num">{{summary.pending}}</view>
        <view class="summary-label">{{summaryL2}}</view>
      </view>
      <view class="summary-card success">
        <view class="summary-num">{{summary.completed}}</view>
        <view class="summary-label">{{summaryL3}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <view>
          <view class="section-title">{{sectionRoutine}}</view>
          <view class="section-subtitle">{{sectionRoutineSub}}</view>
        </view>
        <view class="section-action" bindtap="markAllDone">{{sectionMarkAll}}</view>
      </view>

      <block wx:for="{{routines}}" wx:key="id">
        <view class="routine-item {{item.enabled ? '' : 'routine-disabled'}}">
          <view class="routine-main">
            <view class="routine-time">{{item.time}}</view>
            <view class="routine-info">
              <view class="routine-title-row">
                <text class="routine-title">{{item.title}}</text>
                <text class="routine-status {{item.done ? 'done-text' : 'pending-text'}}">{{item.done ? routineDoneText : routinePendingText}}</text>
              </view>
              <view class="routine-desc">{{item.desc}}</view>
            </view>
          </view>
          <view class="routine-actions">
            <switch checked="{{item.enabled}}" color="#42B983" data-id="{{item.id}}" bindchange="toggleRoutine" />
            <view class="done-btn {{item.done ? 'done-btn-active' : ''}}" data-id="{{item.id}}" bindtap="markRoutineDone">
              {{item.done ? routineDoneText : markCompleteText}}
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="section-card weather-section">
      <view class="section-header no-border">
        <view>
          <view class="section-title">{{sectionWeather}}</view>
          <view class="section-subtitle">{{sectionWeatherSub}}</view>
        </view>
      </view>

      <block wx:for="{{weatherAlerts}}" wx:key="id">
        <view class="alert-item">
          <view class="alert-tag">{{item.level}}</view>
          <view class="alert-title">{{item.title}}</view>
          <view class="alert-desc">{{item.desc}}</view>
          <view class="alert-bottom">
            <text class="alert-bottom-text">{{item.tag}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="tab-bar">
    <view class="tab-item" bindtap="switchTabPage" data-url="/pages/home/home">
      <image class="tab-icon" src="{{tabHomeIcon}}"></image>
      <text>{{tabHome}}</text>
    </view>
    <view class="tab-item" bindtap="switchTabPage" data-url="/subpackage/pkg-feature/reminder/reminder">
      <image class="tab-icon" src="{{tabReminderIcon}}"></image>
      <text class="active-text">{{tabReminder}}</text>
    </view>
    <view class="tab-item tab-add" bindtap="goToChat">
      <view class="ai-avatar-wrapper">
        <image
          class="ai-avatar"
          src="{{aiAvatar}}"
          mode="aspectFill"
        />
      </view>
    </view>
    <view class="tab-item" bindtap="switchTabPage" data-url="/subpackage/pkg-feature/health-bar/health-bar">
      <image class="tab-icon" src="{{tabHealthIcon}}"></image>
      <text>{{tabHealth}}</text>
    </view>
    <view class="tab-item" bindtap="switchTabPage" data-url="/subpackage/pkg-feature/mine/mine">
      <image class="tab-icon" src="{{tabMineIcon}}"></image>
      <text>{{tabMine}}</text>
    </view>
  </view>
</view>