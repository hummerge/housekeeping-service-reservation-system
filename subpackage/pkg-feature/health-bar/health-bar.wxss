/* ==================== 全局基础 ==================== */
page {
  background: #FDFAF5;
  min-height: 100vh;
}

.nav-bar {
  padding-top: 44px;
  height: 44px;
  background: linear-gradient(135deg, #F4A261 0%, #E76F51 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 12px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.nav-back-icon {
  font-size: 33px;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 23px;
  color: #FFFFFF;
  font-weight: 700;
  letter-spacing: 2px;
}

.content {
  height: calc(100vh - 44px - env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 顶部：步数能量环 ==================== */
.section-vitality {
  padding: 32rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #FFF5ED 0%, #FDFAF5 100%);
}

.vitality-ring-wrapper {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vitality-canvas {
  width: 300rpx;
  height: 300rpx;
  position: absolute;
  left: 0;
  top: 0;
}

.vitality-center {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
  pointer-events: none;
}

.vitality-steps {
  font-size: 80rpx;
  font-weight: 900;
  color: #E76F51;
  line-height: 1;
  letter-spacing: -2px;
}

.vitality-label {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #B5613A;
  font-weight: 600;
  letter-spacing: 1px;
}

.vitality-divider {
  margin-top: 10rpx;
  width: 40rpx;
  height: 2rpx;
  background: rgba(231, 111, 81, 0.3);
  border-radius: 2rpx;
}

.vitality-target {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #C47A5A;
  font-weight: 500;
}

/* 环形下方三个指标 */
.vitality-metrics {
  margin-top: 24rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(231, 111, 81, 0.08);
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #E76F51;
  line-height: 1;
}

.metric-desc {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
}

.metric-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.06);
}

/* ==================== 中部：AI 健康私语 ==================== */
.section-wisdom {
  padding: 0 32rpx 24rpx;
}

.wisdom-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(231, 111, 81, 0.1);
  border: 1rpx solid rgba(231, 111, 81, 0.06);
}

.wisdom-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 18rpx;
}

.wisdom-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #FFF0E8 0%, #FFE0CC 100%);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.wisdom-icon {
  font-size: 30rpx;
  line-height: 1;
}

.wisdom-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 1px;
}

.wisdom-content {
  display: block;
  font-size: 32rpx;
  color: #555555;
  line-height: 1.8;
  font-weight: 500;
  min-height: 80rpx;
}

.wisdom-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.wisdom-step-hint {
  font-size: 28rpx;
  color: #AAAAAA;
  font-weight: 500;
}

.wisdom-auth-btn {
  background: linear-gradient(135deg, #F4A261 0%, #E76F51 100%);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wisdom-auth-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.wisdom-synced {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 600;
}

/* ==================== 底部：健康百科/科目 ==================== */
.section-library {
  padding: 0 32rpx 0;
}

.library-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.library-title {
  font-size: 39rpx;
  font-weight: 800;
  color: #333333;
  letter-spacing: 1px;
}

.library-more {
  font-size: 30rpx;
  color: #E76F51;
  font-weight: 600;
}

/* 科目分类标签 */
.library-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.library-tab {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  color: #888888;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
  white-space: nowrap;
}

.library-tab.active {
  background: linear-gradient(135deg, #F4A261 0%, #E76F51 100%);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(231, 111, 81, 0.25);
}

/* 文章列表 */
.library-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.library-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 20rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.library-item:active {
  background: rgba(255, 240, 232, 0.8);
  transform: scale(0.98);
}

.library-item-thumb {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFF5ED 0%, #FFE8D6 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.library-item-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.library-item-emoji {
  font-size: 43rpx;
  line-height: 1;
}

.library-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.library-item-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.library-item-desc {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.library-item-meta {
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.library-item-tag {
  font-size: 26rpx;
  color: #E76F51;
  font-weight: 600;
  background: rgba(231, 111, 81, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.library-item-time {
  font-size: 26rpx;
  color: #CCCCCC;
  font-weight: 500;
}

.library-item-arrow {
  flex-shrink: 0;
  font-size: 43rpx;
  color: #CCCCCC;
  font-weight: 300;
  margin-left: 12rpx;
}

.library-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.library-empty text {
  font-size: 32rpx;
  color: #CCCCCC;
  font-weight: 500;
}

/* 底部安全区域 */
.safe-bottom {
  height: 60rpx;
}
