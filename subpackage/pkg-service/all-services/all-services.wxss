page { background: #F7F7F7; }
.page { min-height: 100vh; }
.nav-bar { padding-top: 44px; height: 44px; background: #E8D3B9; display: flex; align-items: center; justify-content: space-between; }
.nav-left,.nav-right { width: 60px; text-align: center; color: #8C6A4B; font-size: 33px; }
.nav-title { font-size: 23px; color: #8C6A4B; font-weight: 600; }
.content { height: calc(100vh - 88px); }
.section { margin: 24rpx; background: #FFFFFF; border-radius: 24rpx; padding: 8rpx 24rpx; }
.section-title { font-size: 36rpx; color: #333333; font-weight: 600; padding: 24rpx 0; }
.service-row { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-top: 1px solid #F2F2F2; font-size: 34rpx; color: #444444; }
.arrow { color: #BBBBBB; font-size: 41rpx; }