<view class="page">
  <view class="nav-bar">
    <view class="nav-left" bindtap="goBack">‹</view>
    <text class="nav-title">全部服务</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view scroll-y class="content">
    <block wx:for="{{categories}}" wx:key="title">
      <view class="section">
        <view class="section-title">{{item.title}}</view>
        <block wx:for="{{item.items}}" wx:key="type">
          <view class="service-row" bindtap="goDetail" data-type="{{item.type}}">
            <text>{{item.name}}</text>
            <text class="arrow">›</text>
          </view>
        </block>
      </view>
    </block>
  </scroll-view>
</view>